# NearMiss .gitignore

# Virtual environment
.venv/
venv/

# Datasets (download via scripts; see README)
data/
cache/

# Pipeline outputs (generated at runtime)
runs/

# Secrets / env
.env
.env.*
*.key

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# Media (datasets)
*.mp4
*.mov
*.MOV
*.mkv
*.zip
*.tar.gz

# Local SQLite WAL / SHM files (keep the main .db)
*.db-journal
*.db-wal
*.db-shm

# One-off dev patches (not part of the product)
patch_*.py
strip_bom*.py
extract_videos.py

# IDE / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
