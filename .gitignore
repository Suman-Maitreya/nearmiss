# NearMiss .gitignore

# Virtual environment
.venv/
venv/

# Datasets (download via scripts; see README)
data/
cache/

# Pipeline outputs (generated at runtime) — EXCEPT the real Spark evidence
# frames the Mission Deck UI loads (nearmiss/mission_deck.py), which must
# ship with the repo or a fresh clone shows no Spark images at all.
runs/*
!runs/real_evidence_*/
!runs/real_evidence_*/**

# Secrets / env
.env
.env.*
*.key

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# Media (datasets)
*.mp4
*.mov
*.MOV
*.mkv
*.zip
*.tar.gz

# Local SQLite WAL / SHM files (keep the main .db)
*.db-journal
*.db-wal
*.db-shm

# One-off dev patches (not part of the product)
patch_*.py
strip_bom*.py
extract_videos.py

# IDE / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# SAM 3.1 raw response dumps (development smoke tests)
scripts/sam_*.txt

# Local deliverables / generated previews (not part of the product)
Claude outputs/
marketing/dashboard_real.html

# Superseded drafts — build_event_locations3.py is the committed, final version
scripts/build_event_locations.py
scripts/build_event_locations2.py
